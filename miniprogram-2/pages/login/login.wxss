/* pages/login/login.wxss */
page {
  background-color: #f5faf6;
  height: 100%;
}

.container {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
  box-sizing: border-box;
}

.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  width: 100%;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 48rpx;
  color: #2d6a4f;
  display: block;
}

.input {
  background: #f8faf8;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  border: 1px solid #e8f0e8;
  border-radius: 16rpx;
}

.login-btn {
  background: #2d6a4f;
  color: #ffffff;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
}

.register-tip {
  text-align: center;
  margin-top: 32rpx;
  color: #52b788;
  font-size: 28rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 85%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #2d6a4f;
}

.modal-input {
  background: #f8faf8;
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  border: 1px solid #e8f0e8;
  border-radius: 16rpx;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
}

.modal-btn.cancel {
  background: #f0faf0;
  color: #666;
}

.modal-btn.confirm {
  background: #2d6a4f;
  color: #fff;
}