/* pages/market/market.wxss */

page {
  background-color: #f5f5f5;
}

.market-container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* ========== 顶部搜索栏 ========== */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
}

.search-icon {
  font-size: 32rpx;
  color: #999;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.message-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.msg-icon {
  font-size: 44rpx;
  color: #333;
}

.msg-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #ff4757;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 轮播图 ========== */
.banner-swiper {
  width: 100%;
  height: 320rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* ========== 图标入口网格 ========== */
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #ffffff;
  padding: 24rpx 16rpx;
  margin-top: 16rpx;
}

.icon-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.icon-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #e8f5e9;
}

.icon-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333;
}

/* ========== 头条公告 ========== */
.notice-bar {
  display: flex;
  align-items: center;
  background-color: #e8f5e9;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.notice-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.notice-swiper {
  flex: 1;
  height: 36rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #2d6a4f;
}

.notice-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* ========== 商品瀑布流 ========== */
.waterfall-section {
  padding: 0 16rpx;
  margin-top: 16rpx;
  background-color: #f5f5f5;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d6a4f;
}

.more-link {
  font-size: 26rpx;
  color: #999;
}

.waterfall-container {
  display: flex;
  gap: 16rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.product-img {
  width: 100%;
  height: 340rpx;
  background-color: #f5f5f5;
}

.product-info {
  padding: 16rpx;
}

.product-title {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  height: 78rpx;
}

.product-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff4757;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

.product-tag {
  margin-top: 12rpx;
}

.tag-text {
  font-size: 20rpx;
  color: #2d6a4f;
  background-color: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* ========== 加载更多 ========== */
.load-more, .no-more {
  text-align: center;
  padding: 30rpx 0;
}

.load-more-text, .no-more-text {
  font-size: 26rpx;
  color: #999;
}