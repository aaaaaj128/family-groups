<!--pages/profile/profile.wxml-->
<view class="container">
  <view class="card">
    
    <!-- 头像区域（可点击修改） -->
    <view class="avatar-section" bindtap="chooseAvatar">
      <image class="avatar" src="{{currentUser.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="avatar-edit">
        <text class="edit-text">点击修改头像</text>
      </view>
    </view>
    
    <view class="info-item">
      <text class="label">用户名</text>
      <text class="value">{{currentUser.username}}</text>
    </view>
    
    <view class="info-item">
      <text class="label">手机号</text>
      <input class="input-value" value="{{editPhone}}" bindinput="onPhoneInput" />
    </view>
    
    <view class="info-item">
      <text class="label">角色</text>
      <input class="input-value" value="{{editRole}}" bindinput="onRoleInput" />
    </view>
    
    <view class="info-item">
      <text class="label">新密码</text>
      <input class="input-value" placeholder="留空则不修改" password bindinput="onPwdInput" />
    </view>
    
    <button class="save-btn" bindtap="saveProfile">保存修改</button>
  </view>
  
  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>