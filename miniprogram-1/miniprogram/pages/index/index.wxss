/* pages/index/index.wxss */

page {
  background-color: #f5faf6;
  height: 100%;
  width: 100%;
}

.container {
  height: 100%;
  width: 100%;
  position: relative;
}

/* ========== 登录区域 ========== */
.login-area {
  padding: 60rpx 32rpx;
  height: 100%;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  width: 100%;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.login-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 48rpx;
  color: #1a1a1a;
}

.login-input {
  background: #f8faf8;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  border: 1px solid #e8f0e8;
  border-radius: 16rpx;
  color: #1a1a1a;
}

.login-input:focus {
  border-color: #95d5b2;
}

.login-btn {
  background: #2d6a4f;
  color: #ffffff;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin-top: 16rpx;
  border-radius: 44rpx;
}

.register-tip {
  text-align: center;
  margin-top: 32rpx;
  color: #52b788;
  font-size: 28rpx;
}

/* ========== 主界面：三模块固定在顶部，总高度为屏幕一半 ========== */
.main-content {
  display: flex;
  flex-direction: column;
  height: 50%;
  width: 100%;
  padding: 0;
  box-sizing: border-box;
  background-color: #f5faf6;
  position: absolute;
  top: 0;
  left: 0;
}

.module-card {
  flex: 1;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 48rpx;
  border-bottom: 1rpx solid #e8f0e8;
  transition: all 0.2s;
  width: 100%;
  box-sizing: border-box;
}

.module-card:active {
  background: #fafdfa;
}

/* 个人信息模块 - 头像 */
.module-avatar {
  width: 100rpx;
  height: 100rpx;
  margin-right: 32rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #d8f3dc;
  border: 2rpx solid #95d5b2;
}

/* 其他模块 - 图标 */
.module-icon {
  width: 100rpx;
  height: 100rpx;
  background: #f0faf0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 32rpx;
  color: #1a1a1a;
}

/* 信息区域 */
.module-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* 姓名行 */
.name-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

/* 问候语样式 */
.greeting-text {
  font-size: 28rpx;
  color: #666666;
}

.module-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #615f5f;
}

.module-role {
  font-size: 24rpx;
  color: #888888;
}

.module-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #615f5f;
}

.module-arrow {
  font-size: 48rpx;
  color: #d8f3dc;
  font-weight: 300;
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 85%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #1a1a1a;
}

.modal-input {
  background: #f8faf8;
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  border: 1px solid #e8f0e8;
  border-radius: 16rpx;
  color: #1a1a1a;
}

.modal-input:focus {
  border-color: #95d5b2;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
}

.modal-btn.cancel {
  background: #f0faf0;
  color: #666666;
}

.modal-btn.confirm {
  background: #2d6a4f;
  color: #fff;
}